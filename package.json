{
  "name": "dev-dock",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:version": "node --test scripts/test-version.mjs",
    "test:release": "node --test scripts/test-release.mjs",
    "version:set": "node scripts/version.mjs set",
    "version:check": "node scripts/version.mjs check",
    "format": "prettier --write src index.html package.json tsconfig.json vite.config.ts src-tauri/tauri.conf.json src-tauri/capabilities/main.json",
    "format:check": "prettier --check src index.html package.json tsconfig.json vite.config.ts src-tauri/tauri.conf.json src-tauri/capabilities/main.json",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.24"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "typescript": "~5.7.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.0",
    "vue-tsc": "^2.2.0"
  }
}
